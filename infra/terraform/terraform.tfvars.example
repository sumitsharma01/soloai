# Copy to a private terraform.tfvars (ignored by Git). No real secrets go here.
subscription_id       = "00000000-0000-0000-0000-000000000000"
resource_group_name   = "rg-soloai-staging"
name_prefix           = "soloai-stg"
registry_name         = "YOUR_EXISTING_ACR"
container_image       = "YOUR_EXISTING_ACR.azurecr.io/soloai:BUILD_ID"
model_resource_name   = "YOUR_EXISTING_AZURE_OPENAI_ACCOUNT"
model_deployment_name = "YOUR_CHAT_DEPLOYMENT"

# Shared application replicas, not replicas per customer.
min_replicas            = 1
max_replicas            = 3

# Azure SQL free allowance, with AutoPause at the limit. Cloudflare is the public edge.
initialize_schema   = true

# Supply database_admin_password using TF_VAR_database_admin_password.
# For a migrated production database set runtime_database_url via your secret
# store and initialize_schema=false.
# Set alert_email to your operations address to enable email notifications.
tags = {
  environment = "staging"
  owner       = "founder"
}

# Tune for expected traffic/NAT users. WAF is not a billing or tenant quota.
edge_requests_per_10_seconds = 50
cloudflare_account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"
cloudflare_zone_id = "YOUR_EXISTING_FREE_ZONE_ID"
public_hostname = "soloai.example.com"
# Choose a reviewed version or digest before deploying.
cloudflared_image = "cloudflare/cloudflared:2026.3.0"
# Before deployment the shared OpenAI account must have public network access
# and local key authentication disabled. SoloAI uses managed identity + Private Link.
