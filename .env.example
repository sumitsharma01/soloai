SOLOAI_ENV=development
DATABASE_URL=sqlite:///./soloai.db
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Omit endpoint for explicitly labeled simulated local responses.
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME

# Optional: use a reviewed Foundry AGENT instead of direct model completions.
# This takes precedence over AZURE_OPENAI_ENDPOINT. Authenticate with az login
# locally; use a managed identity with project permissions in Azure.
# AZURE_FOUNDRY_PROJECT_ENDPOINT=https://RESOURCE.services.ai.azure.com/api/projects/PROJECT
# AZURE_FOUNDRY_AGENT_NAME=soloai-support
# AZURE_FOUNDRY_AGENT_VERSION=1
# AZURE_FOUNDRY_MODEL=gpt-5.4

# Opt in to durable email intake and TEMPORARY email/draft retention for review.
# Production requires PostgreSQL, explicit migration and a running worker.
SOLOAI_EMAIL_WORKFLOWS=false
SOLOAI_EMAIL_RETENTION_HOURS=168
# Separate reviewed email agent; the original soloai-support stays tool-free.
# AZURE_FOUNDRY_EMAIL_AGENT_NAME=soloai-email
# AZURE_FOUNDRY_EMAIL_AGENT_VERSION=1
# Start worker with its own loopback metrics port (e.g. 9465).

# Optional Gmail read-only intake. Keep both files outside the repository/image.
# GMAIL_CLIENT_FILE=/absolute/private/path/google-client.json
# GMAIL_TOKEN_KEY_FILE=/absolute/private/path/gmail-token.key

# Optional operator-owned JSON outside Git. Tenant IDs map to approved booking MCP
# endpoints and tenant-scoped credentials. See docs/MCP.md. Omit for local snapshots.
# SOLOAI_MCP_CONFIG_FILE=/absolute/private/path/booking-mcp.json

# Direct Azure model option (email tool loop runs in SoloAI).
# Leave AZURE_FOUNDRY_PROJECT_ENDPOINT unset to select this mode.
# Store the key in a private environment file, never in Git.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Optional browser voice preview. Operator credentials stay on the server.
# Use the resource root, not the full realtime URL. See docs/VOICE-RECEPTIONIST.md.
# SOLOAI_VOICE_AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# SOLOAI_VOICE_AZURE_DEPLOYMENT=gpt-realtime-2.1-mini
# SOLOAI_VOICE_AZURE_API_KEY=
# SOLOAI_VOICE_DAILY_SECONDS=600
